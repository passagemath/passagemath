graft passagemath_lie

include VERSION.txt

prune sage

include sage/combinat/root_system/reflection_group_complex.p*
include sage/combinat/root_system/reflection_group_real.p*
include sage/interfaces/lie.p*
include sage/libs/lie.p*

global-exclude *.c
global-exclude *.cpp

global-exclude    all__sagemath_*.py
global-include    all__sagemath_lie.py

include repair_wheel.py

global-exclude __pycache__
global-exclude *.py[co]
global-exclude *.bak
global-exclude *.so
global-exclude *~
prune .tox
prune build
prune dist
