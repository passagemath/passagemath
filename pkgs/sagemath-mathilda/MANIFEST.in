graft passagemath_mathilda

prune sage

include VERSION.txt

include sage/interfaces/mathilda.p*
include sage/libs/mathilda.p*

graft sage/ext_data/doctest/invalid

global-exclude *.c
global-exclude *.cpp

global-exclude all__sagemath_*.py
global-include all__sagemath_mathilda.py

include repair_wheel.py

global-exclude __pycache__
global-exclude *.py[co]
global-exclude *.bak
global-exclude *.so
global-exclude *~
prune .tox
prune build
prune dist
