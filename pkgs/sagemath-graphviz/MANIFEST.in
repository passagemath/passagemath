graft passagemath_graphviz

include VERSION.txt

prune sage

include sage/libs/graphviz.p*

global-exclude *.c
global-exclude *.cpp

global-exclude    all__sagemath_*.py
global-include    all__sagemath_graphviz.py

global-exclude __pycache__
global-exclude *.py[co]
global-exclude *.bak
global-exclude *.so
global-exclude *~
prune .tox
prune build
prune dist
