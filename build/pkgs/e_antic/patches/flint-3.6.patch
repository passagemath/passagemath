-
-        while ((j >= 0) && (t == 0))
-        {
-            t = fmpz_sgn(q + j);
-            j--;
-        }
-
-        while ((j >= 0) && ((fmpz_sgn(q + j) == t) || (fmpz_sgn(q + j) == 0)))
-            j--;
-
-        if (j < 0)
-        {
-            /* all coefficients of q are non-negative */
