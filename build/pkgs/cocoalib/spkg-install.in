set -ex

cd src/

# The handwritten configure script breaks due to quoting bugs when CXX="g++ -std=gnu++11" or similar.
export CXX=$(echo "$CXX" | sed 's/ *.*//')

# there is room for adding more options (set some flags, use a lot of libraries
# shipped with Sage): go to the source directory and type: ./configure --help

sed -i.bak '/boost-find-lib.sh/s,$SCRIPT_DIR/,bash -x $SCRIPT_DIR/,' ./configure

# This is NOT a autoconf script, so sdh_configure does not work
bash -x ./configure --prefix="${SAGE_LOCAL}" --with-boost-hdr-dir="${SAGE_LOCAL}/include"

sdh_make library
sdh_make install
