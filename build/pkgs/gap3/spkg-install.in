# Installation script for gap3; based on the installation script for gap4.

###########################################
## SETUP
###########################################

GAP3_DIR="gap-$PKG_VER"
INSTALL_DIR="$SAGE_LOCAL/$PKG_BASE/$GAP3_DIR/gap3"

echo "spkg-install is using"
echo "GAP3_DIR = $GAP3_DIR"
echo "INSTALL_DIR = $INSTALL_DIR"

###########################################
## INSTALLATION
###########################################

# GAP3 has its own string.h, which shadows the C library header in this tree.
perl -0pi.bak -e 's/# include[[:space:]]*<string\.h>/typedef __SIZE_TYPE__ gap3_size_t;\nextern gap3_size_t strlen(const char *);\nextern int strcmp(const char *, const char *);\nextern char *strncat(char *, const char *, gap3_size_t);/' src/src/system.c
perl -0pi.bak -e 's/#include <string\.h>/typedef __SIZE_TYPE__ gap3_size_t;\nextern gap3_size_t strlen(const char *);\nextern char *strcat(char *, const char *);/' src/src/gasman.c

# The manylinux images do not provide static libc.
sed -i.bak 's/ LOPTS="$(LOPTS) -static"/ LOPTS="$(LOPTS)"/g' src/src/Makefile

cd src/src
sdh_make
cd ..

echo "Installing (copying) files..."
sdh_install * "$INSTALL_DIR"

echo "Creating symlink to new $PKG_BASE installation..."
rm -f "$SAGE_LOCAL/$PKG_BASE/latest"
ln -s "$GAP3_DIR" "$SAGE_DESTDIR_LOCAL/$PKG_BASE/latest"
if [[ $? -ne 0 ]]; then
    echo >&2 "Error creating symbolic link '$SAGE_LOCAL/$PKG_BASE/latest'"
    exit 1
fi

echo "Copying GAP3 startup script..."
rm -f "$SAGE_LOCAL/bin/gap3"
sdh_install -T ../gap3.sh "$SAGE_LOCAL/bin/gap3"
