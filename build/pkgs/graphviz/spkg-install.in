cd src
sdh_configure --disable-swig --disable-ruby --disable-sharp --disable-go \
    --disable-guile --disable-java --disable-lua --disable-perl --disable-php \
    --disable-python --disable-python3 --disable-tcl \
    --without-libgd --disable-ltdl \
    $GRAPHVIZ_CONFIGURE
