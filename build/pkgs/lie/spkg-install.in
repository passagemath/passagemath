# patching
cd src

chmod -R a+rX .

# Patch out conflict with 'index' from string.h
sed -i.bak 's/index/Index/g' *.{c,h,y} **/*.{c,h,y}

# Building LiE in parallel is broken
export MAKE="$MAKE -j1"

# building
sdh_make CC="$CC -std=gnu17"

# install
# following https://salsa.debian.org/debian/lie/-/blob/master/debian/install
sdh_install -T Lie.exe "$SAGE_LOCAL"/lib/lie/lie
sdh_install -T INFO* *.ind "$SAGE_LOCAL"/lib/lie
sdh_install -T ../lie.sh "$SAGE_LOCAL/bin/lie"
