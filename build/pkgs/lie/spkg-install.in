# patching
cd src

chmod -R a+rX .

# Patch out conflict with 'index' from string.h
sed -i.bak 's/index/Index/g' *.{c,h,y} **/*.{c,h,y}

# Building LiE in parallel is broken
export MAKE="$MAKE -j1"

# building
sdh_make CC="$CC -std=gnu17"

# "install" the LiE package by moving over the complete build
# directory to $SAGE_LOCAL/lib/LiE

sdh_install . "$SAGE_LOCAL"/lib/LiE
sdh_install -T ../lie.sh "$SAGE_LOCAL/bin/lie"
