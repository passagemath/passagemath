From 7a9a05d1ea7738817b1f9fee30d7af62fd44b4c6 Mon Sep 17 00:00:00 2001
From: Sam Blake <samuel.thomas.blake@gmail.com>
Date: Fri, 16 Oct 2026 11:08:26 +1100
Subject: [PATCH] fix(build): resolve Homebrew prefix via $HOMEBREW instead of
 hardcoding /opt/homebrew (#90)

The makefile and the CMake test build hardcoded /opt/homebrew (the
Apple-Silicon default) for the optional-dependency include/lib/pkgconfig
search paths, which is wrong on an Intel (/usr/local) or custom-prefix
install. Resolve a single HOMEBREW prefix instead:

  * Auto-detected via `brew --prefix`, so Apple-Silicon (/opt/homebrew),
    Intel (/usr/local), Linuxbrew, and custom prefixes all work with no
    edits; falls back to the conventional macOS prefixes when brew is
    absent.
  * Overridable: `make HOMEBREW=/my/prefix` / `export HOMEBREW=...`
    (CMake also accepts -DHOMEBREW=...).
  * Disableable, as the issue asks: HOMEBREW= (empty) or
    HOMEBREW=/nonexisting makes every $(wildcard $(HOMEBREW)/...) /
    EXISTS guard miss, turning off all Homebrew discovery (plain
    pkg-config, readline falls back to the libedit shim).

Linux/Windows behaviour is unchanged (HOMEBREW stays empty when brew is
not on PATH). Documented in docs/building.md. Build tooling only: no
$VersionNumber bump, no tag.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Fg3L9fjm1qwnR2vQUB3GBh
---
 docs/building.md     |  4 +++
 makefile             | 84 ++++++++++++++++++++++++++++++++++----------
 tests/CMakeLists.txt | 66 ++++++++++++++++++++--------------
 3 files changed, 110 insertions(+), 44 deletions(-)

diff --git a/docs/building.md b/docs/building.md
index 76052c94..0cb66e36 100644
--- a/docs/building.md
+++ b/docs/building.md
@@ -242,6 +242,10 @@ cargo tauri dev
 | `USE_READLINE=0` | `1` | Disable GNU Readline (required on Windows; auto-detected) |
 | `USE_GRAPHICS=0` | `1` | Disable Raylib 2D graphics engine |
 | `USE_LAPACK=0` | `1` | Disable BLAS/LAPACK linear-algebra kernels |
+| `HOMEBREW=<prefix>` | auto (`brew --prefix`) | Homebrew prefix whose `include`, `lib`, and `lib/pkgconfig` directories are added to the search paths for the optional dependencies above. Auto-detected with `brew --prefix`, so the Apple-Silicon `/opt/homebrew`, the Intel `/usr/local`, a Linuxbrew prefix, and any custom install all work without editing the makefile. Pass it explicitly to force a prefix, or **opt out of all Homebrew discovery** with `HOMEBREW=` (empty) or `HOMEBREW=/nonexisting`. Honoured identically by the makefile and the CMake test build. |
+
+`HOMEBREW` is read from the command line or the environment (`make HOMEBREW=/opt/homebrew`,
+`export HOMEBREW=`); the CMake test build also accepts `-DHOMEBREW=...`.
 
 ---
 
diff --git a/makefile b/makefile
index 91a0e85f..2444af4b 100644
--- a/makefile
+++ b/makefile
@@ -16,6 +16,52 @@ else
   BUILD_PLATFORM := Windows
 endif
 
+# Homebrew prefix (issue #90). Mathilda's optional dependencies (readline,
+# gmp-ecm, flint, raylib, pcre2, fftw, ...) are typically installed via Homebrew
+# on macOS, whose keg layout sits outside the default compiler / pkg-config
+# search paths; the probes below add the prefix's include/lib/pkgconfig dirs so a
+# plain `make` finds them. Rather than hardcode /opt/homebrew (the Apple-Silicon
+# default, wrong on Intel and on a custom prefix), resolve HOMEBREW once:
+#
+#   1. An explicit HOMEBREW=... (command line or environment) always wins. This
+#      is also the documented opt-out: HOMEBREW= (empty) or HOMEBREW=/nonexisting
+#      makes every $(wildcard $(HOMEBREW)/...) guard below miss, disabling all
+#      Homebrew discovery.
+#   2. Otherwise `brew --prefix` if a brew is on PATH — this handles the
+#      Apple-Silicon /opt/homebrew, the Intel /usr/local, a Linuxbrew prefix, and
+#      any custom install uniformly.
+#   3. Otherwise, on macOS only, the first conventional prefix that exists.
+#
+# Only the explicit-override case ($(origin) test) skips auto-detection, so the
+# two opt-out spellings in (1) are honoured verbatim.
+ifeq ($(origin HOMEBREW),undefined)
+  HOMEBREW := $(shell brew --prefix 2>/dev/null)
+  ifeq ($(strip $(HOMEBREW)),)
+    ifeq ($(BUILD_PLATFORM),Darwin)
+      HOMEBREW := $(firstword $(wildcard /opt/homebrew /usr/local))
+    endif
+  endif
+endif
+
+# Homebrew-derived search paths, each added only if it actually exists under the
+# resolved prefix. All empty when HOMEBREW is empty/absent (opt-out, Linux
+# without Linuxbrew, Windows), so the consumers below collapse to the
+# no-Homebrew behaviour.
+HOMEBREW_CFLAGS  :=
+HOMEBREW_LDFLAGS :=
+HOMEBREW_PC_PATH :=
+ifneq ($(strip $(HOMEBREW)),)
+  ifneq ($(wildcard $(HOMEBREW)/include),)
+    HOMEBREW_CFLAGS := -I$(HOMEBREW)/include
+  endif
+  ifneq ($(wildcard $(HOMEBREW)/lib),)
+    HOMEBREW_LDFLAGS := -L$(HOMEBREW)/lib
+  endif
+  ifneq ($(wildcard $(HOMEBREW)/lib/pkgconfig),)
+    HOMEBREW_PC_PATH := $(HOMEBREW)/lib/pkgconfig
+  endif
+endif
+
 # Compiler. Mathilda must be built with a REAL GCC, never Apple's clang shim: on
 # macOS the plain `gcc` is a symlink to Apple clang, and LLVM both miscompiles some
 # of our -std=c99 paths and hides the glibc portability class the Linux CI gates on.
@@ -102,9 +148,12 @@ else
   # build falls back to the shim (single-line editing only). Linux resolves GNU
   # Readline through -lreadline already, so this probe is Darwin-only.
   ifeq ($(BUILD_PLATFORM),Darwin)
-    READLINE_PREFIX := $(shell for p in $$(brew --prefix readline 2>/dev/null) /opt/homebrew/opt/readline /usr/local/opt/readline; do \
-                                 [ -f "$$p/include/readline/readline.h" ] && { echo $$p; break; }; \
-                               done)
+    # Keg-only: Homebrew symlinks readline at $(HOMEBREW)/opt/readline, so the
+    # resolved prefix locates it without a second `brew` call. An empty /
+    # non-existent HOMEBREW (the opt-out) finds nothing and falls back to the
+    # libedit shim (single-line editing only).
+    READLINE_PREFIX := $(patsubst %/include/readline/readline.h,%,\
+                         $(wildcard $(HOMEBREW)/opt/readline/include/readline/readline.h))
     ifneq ($(READLINE_PREFIX),)
       CFLAGS        += -I$(READLINE_PREFIX)/include
       READLINE_LIBS := -L$(READLINE_PREFIX)/lib -lreadline
@@ -207,8 +256,8 @@ endif
 # the default linker path, so -lecm resolves without an explicit -L there.
 ifeq ($(USE_ECM), 1)
   ECM_PROBE := $(shell printf '\#include <stdio.h>\n\#include <ecm.h>\nint main(void){ecm_params p;ecm_init(p);return 0;}\n' > /tmp/mathilda_ecmprobe.c 2>/dev/null && \
-    $(CC) /tmp/mathilda_ecmprobe.c -o /tmp/mathilda_ecmprobe -I/usr/include -I/usr/local/include -I/opt/homebrew/include \
-      -L/usr/local/lib -L/opt/homebrew/lib -lecm -lgmp 2>/dev/null && echo y; \
+    $(CC) /tmp/mathilda_ecmprobe.c -o /tmp/mathilda_ecmprobe -I/usr/include -I/usr/local/include $(HOMEBREW_CFLAGS) \
+      -L/usr/local/lib $(HOMEBREW_LDFLAGS) -lecm -lgmp 2>/dev/null && echo y; \
     rm -f /tmp/mathilda_ecmprobe.c /tmp/mathilda_ecmprobe)
   ifeq ($(ECM_PROBE), y)
     LDFLAGS += -lecm
@@ -236,23 +285,22 @@ CFLAGS  += -DUSE_MPFR
 LDFLAGS += -lmpfr
 endif
 
-ifneq ($(wildcard /opt/homebrew/include),)
-CFLAGS += -I/opt/homebrew/include
-endif
-
-ifneq ($(wildcard /opt/homebrew/lib),)
-LDFLAGS += -L/opt/homebrew/lib
-endif
+# Homebrew include/lib dirs (resolved above; empty when HOMEBREW is opted out or
+# absent). /usr/local is already on CFLAGS/LDFLAGS unconditionally, so on an
+# Intel-prefix install these may duplicate it harmlessly.
+CFLAGS  += $(HOMEBREW_CFLAGS)
+LDFLAGS += $(HOMEBREW_LDFLAGS)
 
 # pkg-config wrapper. On macOS, Homebrew installs its .pc files outside the
 # search path used by a MacPorts/system pkg-config, so `pkg-config --exists
 # raylib` (below) fails on a stock shell even when raylib is installed. Prepend
-# the Homebrew prefixes (Apple-Silicon + Intel) on Darwin so plain `make`
-# detects raylib — and graphics is built by default — without a manual
-# PKG_CONFIG_PATH override. Harmless on Linux (the directories simply don't
-# exist) and respects any PKG_CONFIG_PATH the user already exported.
-ifeq ($(BUILD_PLATFORM),Darwin)
-  PKG_CONFIG = PKG_CONFIG_PATH="/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig:$$PKG_CONFIG_PATH" pkg-config
+# the resolved Homebrew prefix's pkgconfig dir (HOMEBREW_PC_PATH, computed above)
+# so plain `make` detects raylib — and graphics is built by default — without a
+# manual PKG_CONFIG_PATH override. Empty when Homebrew is opted out or absent
+# (Linux, Windows), so this collapses to plain pkg-config there; respects any
+# PKG_CONFIG_PATH the user already exported.
+ifneq ($(HOMEBREW_PC_PATH),)
+  PKG_CONFIG = PKG_CONFIG_PATH="$(HOMEBREW_PC_PATH):$$PKG_CONFIG_PATH" pkg-config
 else
   PKG_CONFIG = pkg-config
 endif
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 92c89a4b..79ef1d36 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -100,19 +100,45 @@ if(USE_LAPACK)
     endif()
 endif()
 
+# Homebrew prefix discovery (issue #90), mirroring the makefile. An explicit
+# HOMEBREW — cache (-DHOMEBREW=...) or environment — always wins and is the
+# opt-out: HOMEBREW= (empty) or HOMEBREW=/nonexisting makes the EXISTS guards
+# below skip, disabling all Homebrew discovery. Otherwise auto-detect via
+# `brew --prefix` (Apple-Silicon /opt/homebrew, Intel /usr/local, Linuxbrew, or
+# a custom prefix — uniformly), falling back to the conventional macOS prefixes.
+if(DEFINED HOMEBREW)
+    # cache / -D override (possibly empty) wins as-is
+elseif(DEFINED ENV{HOMEBREW})
+    set(HOMEBREW "$ENV{HOMEBREW}")
+else()
+    execute_process(COMMAND brew --prefix
+                    OUTPUT_VARIABLE HOMEBREW OUTPUT_STRIP_TRAILING_WHITESPACE
+                    ERROR_QUIET)
+    if(NOT HOMEBREW AND APPLE)
+        foreach(_p "/opt/homebrew" "/usr/local")
+            if(EXISTS "${_p}")
+                set(HOMEBREW "${_p}")
+                break()
+            endif()
+        endforeach()
+    endif()
+endif()
+
+# On macOS, Homebrew installs its .pc files outside the search path used by a
+# MacPorts/system pkg-config, so the pkg_check_modules probes below fail on a
+# stock shell even when the library is installed. Prepend the resolved Homebrew
+# prefix's pkgconfig dir once, so raylib / flint / pcre2 / fftw are all detected
+# by default — matching the makefile. Empty/absent HOMEBREW (opt-out, Linux,
+# Windows) leaves PKG_CONFIG_PATH untouched.
+if(HOMEBREW AND EXISTS "${HOMEBREW}/lib/pkgconfig")
+    set(ENV{PKG_CONFIG_PATH} "${HOMEBREW}/lib/pkgconfig:$ENV{PKG_CONFIG_PATH}")
+endif()
+
 # Raylib autodetection for the graphics engine.  Mirrors the makefile's
 # pkg-config probe; degrades to USE_GRAPHICS=OFF (sampling.c and the
 # symbolic Graphics[]/Plot[] construction path are still fully testable —
 # only render.c/label_font.c, which need a live display, are excluded).
 if(USE_GRAPHICS)
-    # On macOS, Homebrew installs its .pc files outside the search path used by
-    # a MacPorts/system pkg-config, so the probe below fails on a stock shell
-    # even when raylib is installed. Prepend the Homebrew prefixes (Apple-
-    # Silicon + Intel) so graphics is detected by default, matching the makefile.
-    if(APPLE)
-        set(ENV{PKG_CONFIG_PATH}
-            "/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig:$ENV{PKG_CONFIG_PATH}")
-    endif()
     find_package(PkgConfig QUIET)
     if(PkgConfig_FOUND)
         pkg_check_modules(RAYLIB QUIET raylib)
@@ -158,10 +184,6 @@ endif()
 # graceful degrade: when absent, flint_bridge.c compiles to stubs and the
 # flint_bridge_tests binary skips itself at runtime.
 if(USE_FLINT)
-    if(APPLE)
-        set(ENV{PKG_CONFIG_PATH}
-            "/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig:$ENV{PKG_CONFIG_PATH}")
-    endif()
     find_package(PkgConfig QUIET)
     if(PkgConfig_FOUND)
         pkg_check_modules(FLINT QUIET flint>=3.0)
@@ -183,10 +205,6 @@ endif()
 # graceful degrade: when absent, the regex engine wrapper compiles to stubs and
 # the regex string builtins warn and stay unevaluated at runtime.
 if(USE_REGEX)
-    if(APPLE)
-        set(ENV{PKG_CONFIG_PATH}
-            "/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig:$ENV{PKG_CONFIG_PATH}")
-    endif()
     find_package(PkgConfig QUIET)
     if(PkgConfig_FOUND)
         pkg_check_modules(PCRE2 QUIET libpcre2-8)
@@ -208,10 +226,6 @@ endif()
 # absent, the Fourier machine path compiles to a naive O(n^2) DFT fallback.
 option(USE_FFTW "Use FFTW for the machine-precision Fourier transform" ON)
 if(USE_FFTW)
-    if(APPLE)
-        set(ENV{PKG_CONFIG_PATH}
-            "/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig:$ENV{PKG_CONFIG_PATH}")
-    endif()
     find_package(PkgConfig QUIET)
     if(PkgConfig_FOUND)
         pkg_check_modules(FFTW QUIET fftw3)
@@ -254,19 +268,19 @@ include_directories(../src/graph)
 include_directories(../src/strings)
 include_directories(../src/strings/regex)
 include_directories(../src/solve)
-if(EXISTS "/opt/homebrew/include")
-    include_directories(/opt/homebrew/include)
+if(HOMEBREW AND EXISTS "${HOMEBREW}/include")
+    include_directories(${HOMEBREW}/include)
 endif()
 link_directories(/usr/local/lib)
-if(EXISTS "/opt/homebrew/lib")
-    link_directories(/opt/homebrew/lib)
+if(HOMEBREW AND EXISTS "${HOMEBREW}/lib")
+    link_directories(${HOMEBREW}/lib)
 endif()
 
 # GMP-ECM is a system library (brew install gmp-ecm / apt install libecm-dev),
 # no longer vendored. Detect the public header + shared lib and link -lecm.
 if(USE_ECM)
-    find_path(ECM_INCLUDE_DIR ecm.h PATHS /usr/local/include /opt/homebrew/include)
-    find_library(ECM_LIBRARY NAMES ecm PATHS /usr/local/lib /opt/homebrew/lib)
+    find_path(ECM_INCLUDE_DIR ecm.h PATHS /usr/local/include ${HOMEBREW}/include)
+    find_library(ECM_LIBRARY NAMES ecm PATHS /usr/local/lib ${HOMEBREW}/lib)
     if(ECM_INCLUDE_DIR AND ECM_LIBRARY)
         include_directories(${ECM_INCLUDE_DIR})
         set(ECM_LIB ${ECM_LIBRARY})
