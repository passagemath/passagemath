# Undo "export MSYS=winsymlinks" done in top-level Makefile
unset MSYS

cd src

# See https://github.com/flintlib/flint/issues/2340
export CFLAGS="$CFLAGS -fno-strict-aliasing"

if [ -n "$MSYSTEM" ]; then
    sdh_cmake -G Ninja \
        -DENABLE_ARCH=NO \
        .
    set -e
    cmake --build .
    DESTDIR=$SAGE_DESTDIR cmake --install .
else
    # Use out of tree build as a workaround for
    # https://github.com/passagemath/passagemath/issues/2857
    mkdir build
    cd build
    cp ../configure .
    sdh_configure --srcdir=..
    sdh_make
    sdh_make_install
fi
